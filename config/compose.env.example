# Copy this file to .env for local Docker Compose runs.

# Host port mappings
DCG_SERVICE_PORT=8080
DCG_POSTGRES_PORT=5432
CONTRACTS_VOLUME_MODE=rw

# Database credentials used by both Postgres container and app
DCG_DB_USERNAME=contracts_app
DCG_DB_PASSWORD=change-me

# App basic-auth credentials
DCG_APP_USERNAME=admin
DCG_APP_PASSWORD=change-me

# Artifact backend. Keep filesystem for normal compose; set backend=s3 for the S3 beta smoke.
CONTRACTS_ROOT=/app/contracts
CONTRACTS_ARTIFACT_BACKEND=filesystem
CONTRACTS_ARTIFACT_S3_BUCKET=
CONTRACTS_ARTIFACT_S3_REGION=us-east-1
CONTRACTS_ARTIFACT_S3_PREFIX=contracts
CONTRACTS_ARTIFACT_S3_ENDPOINT=
CONTRACTS_ARTIFACT_S3_PATH_STYLE=false
CONTRACTS_ARTIFACT_S3_ACCESS_KEY=
CONTRACTS_ARTIFACT_S3_SECRET_KEY=
CONTRACTS_ARTIFACT_S3_FALLBACK_ENABLED=false
CONTRACTS_ARTIFACT_S3_LOCAL_CACHE_ROOT=/tmp/dcg-contracts-cache
CONTRACTS_ARTIFACT_S3_SERVER_SIDE_ENCRYPTION=AES256
CONTRACTS_ARTIFACT_S3_KMS_KEY_ID=
