# Local-only configuration for the main Docker/PostgreSQL DCG demo.
# Copy this file to .env.live-demo. Demo credentials only; change them before non-demo use.

DCG_SERVICE_PORT=8080
DCG_POSTGRES_PORT=5432
CONTRACTS_VOLUME_MODE=rw

DCG_DB_USERNAME=contracts_app
DCG_DB_PASSWORD=change-me
DCG_DB_SCHEMA=dcg_prod

DCG_APP_USERNAME=dcg-compose-admin
DCG_APP_PASSWORD=dcg-compose-demo-password
DCG_APP_ROLES=USER,WRITER
APP_SECURITY_EVIDENCE_AUTH_MODE=OIDC
APP_SECURITY_EVIDENCE_AUTH_ALLOW_BASIC=false

CONTRACTS_ROOT=/app/contracts
CONTRACTS_ARTIFACT_BACKEND=filesystem
CONTRACTS_ARTIFACT_S3_FALLBACK_ENABLED=false

# Evidence ingestion limits are enabled in the Compose service.
CHECKS_EVIDENCE_MAX_PAYLOAD_BYTES=1048576
CHECKS_EVIDENCE_RATE_LIMIT_ENABLED=true
CHECKS_EVIDENCE_RATE_LIMIT_REQUESTS_PER_WINDOW=60
CHECKS_EVIDENCE_RATE_LIMIT_WINDOW=1m

# Keep raw-evidence retention disabled for a normal local demo. For a controlled WORM run,
# use config/compose.evidence-worm.env.example and supply the standard AWS credential variables.
CHECKS_EVIDENCE_RETENTION_ENABLED=false
CHECKS_EVIDENCE_RETENTION_DRY_RUN=true
CHECKS_EVIDENCE_ARCHIVE_MODE=DISABLED
