# Controlled Docker Compose configuration for an S3 Object-Lock evidence-retention run.
# Copy to .env.evidence-worm. Do not commit that file or place credentials in this template.
# The container uses the standard AWS_* environment variables forwarded by docker-compose.yml.

DCG_SERVICE_PORT=8080
DCG_POSTGRES_PORT=5432
CONTRACTS_VOLUME_MODE=rw
DCG_DB_USERNAME=contracts_app
DCG_DB_PASSWORD=replace-with-a-unique-db-password
DCG_DB_SCHEMA=dcg_worm_test

# The retention endpoint is intentionally protected by a dedicated role.
DCG_APP_USERNAME=dcg-retention-operator
DCG_APP_PASSWORD=replace-with-a-unique-operator-password
DCG_APP_ROLES=USER,WRITER,RETENTION_ADMIN
APP_SECURITY_RETENTION_ROLE=RETENTION_ADMIN
# Test-data bootstrap only: remove these two settings for a deployment and use the configured OIDC
# workload identity described in config/evidence-oidc.properties.example.
APP_SECURITY_EVIDENCE_AUTH_MODE=BASIC
APP_SECURITY_EVIDENCE_AUTH_ALLOW_BASIC=true

# Evidence ingestion guardrails.
CHECKS_EVIDENCE_MAX_PAYLOAD_BYTES=1048576
CHECKS_EVIDENCE_RATE_LIMIT_ENABLED=true
CHECKS_EVIDENCE_RATE_LIMIT_REQUESTS_PER_WINDOW=60
CHECKS_EVIDENCE_RATE_LIMIT_WINDOW=1m

# S3 WORM archive. The bucket must have Object Lock and versioning enabled.
CHECKS_EVIDENCE_ARCHIVE_MODE=S3_WORM
CHECKS_EVIDENCE_ARCHIVE_S3_BUCKET=s3-evidence-testing-1
CHECKS_EVIDENCE_ARCHIVE_S3_PREFIX=evidence
CHECKS_EVIDENCE_ARCHIVE_S3_REGION=ap-southeast-2
CHECKS_EVIDENCE_ARCHIVE_S3_EXPECTED_BUCKET_OWNER=755395261278
CHECKS_EVIDENCE_ARCHIVE_S3_RETENTION_DAYS=2555
# Production admission rejects endpoints, path-style S3, and static archive credentials.
CHECKS_EVIDENCE_ARCHIVE_S3_ENDPOINT=
CHECKS_EVIDENCE_ARCHIVE_S3_PATH_STYLE=false
CHECKS_EVIDENCE_ARCHIVE_S3_ACCESS_KEY=
CHECKS_EVIDENCE_ARCHIVE_S3_SECRET_KEY=

# Start with one known, test-only evidence record. The 1s periods make it eligible immediately.
CHECKS_EVIDENCE_RETENTION_ENABLED=true
CHECKS_EVIDENCE_RETENTION_DRY_RUN=false
CHECKS_EVIDENCE_RETENTION_POLICY_VERSION=evidence-retention-v1
CHECKS_EVIDENCE_RETENTION_VERIFIED_REJECTED_RETENTION=1s
CHECKS_EVIDENCE_RETENTION_OPERATIONAL_RETENTION=1s
CHECKS_EVIDENCE_RETENTION_BATCH_SIZE=1
