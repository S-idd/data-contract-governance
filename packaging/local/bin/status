#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd -P)/dcg"
state_init
running_ai_mode
result=0
if alive java && ready http://127.0.0.1:8080/actuator/health; then
  printf 'Java service: RUNNING\nDeterministic enforcement: ACTIVE\n'
else
  printf 'Java service: STOPPED\nDeterministic enforcement: INACTIVE\n'
  result=1
fi
if [[ "$RUNNING_AI_ENABLED" == false ]]; then
  if alive rust; then
    printf 'AI advisory mode: UNAVAILABLE\nRust advisory process: RUNNING (unexpected in no-AI mode)\n'
    result=1
  else
    printf 'AI advisory mode: DISABLED\nRust advisory process: STOPPED\nrust: disabled (no-AI mode)\n'
  fi
elif alive rust; then
  if ready http://127.0.0.1:8081/health/ready; then
    printf 'AI advisory mode: AVAILABLE\nRust advisory process: RUNNING\n'
  elif [[ -f "$STATE/advisory-state" && "$(< "$STATE/advisory-state")" == STARTING ]]; then
    printf 'AI advisory mode: STARTING\nRust advisory process: RUNNING\n'
  else
    printf 'AI advisory mode: UNAVAILABLE\nRust advisory process: RUNNING\n'
  fi
elif [[ -n "$(port_listeners 8081)" ]]; then
  printf 'AI advisory mode: UNAVAILABLE\nRust advisory process: NOT OWNED\n'
else
  printf 'AI advisory mode: UNAVAILABLE\nRust advisory process: STOPPED\n'
fi
exit "$result"
