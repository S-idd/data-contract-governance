#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd -P)/dcg"
requested_ai_mode
advisory_startup_timeout
state_init
java_check
lock
running_ai_mode
if alive java; then
  [[ "$AI_ENABLED" == "$RUNNING_AI_ENABLED" ]] || die 'AI mode differs from the running instance. Run bin/stop before changing modes.'
  if [[ "$AI_ENABLED" == true ]]; then
    if alive rust && ready http://127.0.0.1:8081/health/ready; then
      printf 'AI advisory: available.\n'
    else
      printf 'AI advisory: unavailable; continuing with deterministic DCG enforcement.\n'
    fi
  else
    ! alive rust || die 'Unexpected tracked Rust process. Run bin/stop before restarting.'
  fi
  ready http://127.0.0.1:8080/actuator/health || die 'Java is not ready; inspect logs or run bin/stop.'
  printf 'DCG is already running.\n'; exit 0
fi
if alive rust; then die 'Partial instance detected. Run bin/stop before restarting.'; fi
command -v lsof >/dev/null || die 'Install lsof for startup port-conflict checks.'
if lsof -nP -iTCP:8080 -sTCP:LISTEN >/dev/null 2>&1; then die 'Port 8080 is already in use.'; fi
[[ -f "$ROOT/lib/contract-service-$VERSION.jar" ]] || die 'Package Java service is missing.'
if [[ ! -e "$DATA/contracts" ]]; then cp -R "$ROOT/contracts" "$DATA/contracts"; fi
if [[ ! -e "$DATA/application-local-demo.properties" ]]; then
  cp "$ROOT/config/application-local-demo.properties.example" "$DATA/application-local-demo.properties"
fi
if [[ ! -f "$DATA/password" ]]; then
  od -An -N24 -tx1 /dev/urandom | tr -d ' \n' > "$DATA/password"
fi
[[ -s "$DATA/password" ]] || die 'Local password file is empty.'
chmod 600 "$DATA/password"
started_rust=0
started_java=0
cleanup_start() {
  local result=$?
  if [[ "$result" != 0 ]]; then
    [[ "$started_java" == 0 ]] || stop_one java || true
    [[ "$started_rust" == 0 ]] || stop_one rust || true
    printf 'DCG startup failed; see %s/logs.\n' "$DATA" >&2
  fi
  rmdir "$STATE/lock"
}
trap cleanup_start EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cd "$DATA"
export APP_SECURITY_USERNAME=demo
APP_SECURITY_PASSWORD=$(< "$DATA/password")
export APP_SECURITY_PASSWORD
# Explicit options keep this package local even if inherited environment uses shared profiles.
nohup "$JAVA" -jar "$ROOT/lib/contract-service-$VERSION.jar" \
  --spring.config.location="file:$DATA/application-local-demo.properties" \
  --spring.profiles.active=local-demo --server.address=127.0.0.1 --server.port=8080 \
  --management.server.port=8080 \
  --contracts.root="$DATA/contracts" --contracts.policy-packs="$DATA/contracts/policy-packs.json" \
  --contracts.artifact.backend=filesystem --checks.db.url= --checks.db.path="$DATA/checks.db" \
  --app.security.enabled=true --app.security.require-non-default-credentials=true \
  --app.security.evidence-auth.mode=DISABLED \
  --shadow.inference.enabled="$AI_ENABLED" --shadow.inference.endpoint=http://127.0.0.1:8081/v1/shadow/predict \
  >> "$DATA/logs/java.log" 2>&1 < /dev/null &
java_pid=$!
remember java "$java_pid" || die 'Java exited or did not exec before its process identity could be recorded.'
started_java=1
wait_ready java http://127.0.0.1:8080/actuator/health || die 'Java readiness failed.'
printf '%s\n' "$AI_ENABLED" > "$STATE/ai-enabled"
if [[ "$AI_ENABLED" == true ]]; then
  printf 'STARTING\n' > "$STATE/advisory-state"
  if [[ ! -x "$ROOT/bin/dcgaimodel" || ! -d "$ROOT/model" ]]; then
    printf 'UNAVAILABLE\n' > "$STATE/advisory-state"
  elif [[ -n "$(port_listeners 8081)" ]]; then
    printf 'UNAVAILABLE\n' > "$STATE/advisory-state"
  else
    nohup "$ROOT/bin/dcgaimodel" serve-shadow-inference --artifact-root "$ROOT/model" --bind 127.0.0.1:8081 >> "$DATA/logs/rust.log" 2>&1 < /dev/null &
    rust_pid=$!
    if remember rust "$rust_pid"; then
      started_rust=1
      if wait_ready rust http://127.0.0.1:8081/health/ready "$AI_STARTUP_TIMEOUT"; then
        printf 'AVAILABLE\n' > "$STATE/advisory-state"
      else
        printf 'UNAVAILABLE\n' > "$STATE/advisory-state"
        stop_one rust || true
      fi
    else
      printf 'UNAVAILABLE\n' > "$STATE/advisory-state"
    fi
  fi
  if [[ "$(< "$STATE/advisory-state")" == AVAILABLE ]]; then
    printf 'AI advisory: available.\n'
  else
    printf 'AI advisory: unavailable; continuing with deterministic DCG enforcement.\n'
  fi
else
  printf 'DISABLED\n' > "$STATE/advisory-state"
  printf 'AI disabled: no Rust model process started.\n'
fi
printf 'DCG ready: http://127.0.0.1:8080/ui\nLogin: demo; password file: %s/password\nLogs: %s/logs\n' "$DATA" "$DATA"
